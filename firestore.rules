rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/inventory/{itemId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.id == itemId;
      allow delete: if owner(userId);
    }
    match /users/{userId}/cart/{itemId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.id == itemId;
      allow delete: if owner(userId);
    }
    match /users/{userId}/purchases/{itemId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.id == itemId;
      allow delete: if owner(userId);
    }
    match /users/{userId}/settings/{settingsId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.id == settingsId;
      allow delete: if owner(userId);
    }
    match /users/{userId}/plans/{weekId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.id == weekId;
      allow delete: if owner(userId);
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
